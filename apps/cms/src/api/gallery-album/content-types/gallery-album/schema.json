{
  "kind": "collectionType",
  "collectionName": "gallery_albums",
  "info": {
    "singularName": "gallery-album",
    "pluralName": "gallery-albums",
    "displayName": "Gallery Album"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "images": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-image.gallery-image",
      "mappedBy": "album"
    }
  }
}
